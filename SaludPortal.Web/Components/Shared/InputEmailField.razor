@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using SaludPortal.Web.Components.Icons
@using System.Text.RegularExpressions

<div class="input-field-group">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="input-label">@Label</label>
    }
    <div class="input-group @(HasError ? "invalid" : "")">
        <div class="input-icon">
            <Icon Name="@IconName" Size="18" Fill="#666" AriaLabel="@AriaLabel" />
        </div>
        <input type="email"
               inputmode="email"
               class="input-field"
               placeholder="@Placeholder"
               value="@DisplayValue"
               @oninput="OnInput"
               @onchange="OnChange"
               maxlength="@MaxLength"
               disabled="@Disabled" />
    </div>
    <ValidationMessage For="@ValidationFor" class="validation-message" style="color: #dc3545;" />
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string IconName { get; set; } = "envelope";
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public string AriaLabel { get; set; } = "";
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public int MaxLength { get; set; } = 100;
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string>>? ValidationFor { get; set; }
    [Parameter] public bool HasError { get; set; } = false;

    private static readonly Regex EspaciosRegex = new Regex(@"\s", RegexOptions.Compiled);

    private int _inputSeq;
    private string _latest = "";

    // Mientras se escribe, pintar _latest para que un re-render intermedio no pise teclas.
    private string DisplayValue => _inputSeq > 0 ? _latest : Value;

    private async Task OnInput(ChangeEventArgs e)
    {
        // Solo el último keystroke actualiza el modelo (evita carrera Blazor Server).
        _latest = e.Value?.ToString() ?? "";
        var seq = ++_inputSeq;
        await Task.Yield();
        if (seq != _inputSeq)
            return;

        await ValueChanged.InvokeAsync(_latest);
    }

    private async Task OnChange(ChangeEventArgs e)
    {
        string valor = EspaciosRegex.Replace(e.Value?.ToString() ?? "", "").ToLowerInvariant();
        _latest = valor;
        if (!string.Equals(valor, Value, StringComparison.Ordinal))
            await ValueChanged.InvokeAsync(valor);
    }
}
