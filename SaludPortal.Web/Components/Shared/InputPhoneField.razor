@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using SaludPortal.Web.Components.Icons
@using System.Text.RegularExpressions
@inject IJSRuntime JS

<div class="input-field-group">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="input-label">@Label</label>
    }
    <div class="input-group @(HasError || errorCodigoArea || errorTelefono ? "invalid" : "")">
        <div class="input-icon">
            <Icon Name="@IconName" Size="18" Fill="#666" AriaLabel="@AriaLabel" />
        </div>
        <input type="tel"
               inputmode="numeric"
               class="input-field phone-area-input"
               placeholder="Cód. área (sin 0)"
               @ref="codigoAreaInputRef"
               value="@codigoArea"
               @oninput="OnCodigoAreaInput"
               onkeydown="numericInput.preventNonNumeric(event)"
               onpaste="numericInput.pasteDigitsOnly(event)"
               maxlength="@maxLengthCodigoArea"
               disabled="@Disabled" />
        <span class="phone-separator">|</span>
        <input type="tel"
               class="input-field"
               placeholder="Número (sin 15)"
               @ref="telefonoInputRef"
               value="@telefono"
               @oninput="OnTelefonoInput"
               onkeydown="numericInput.preventNonNumeric(event)"
               onpaste="numericInput.pasteDigitsOnly(event)"
               maxlength="@maxLengthTelefono"
               disabled="@Disabled" />
    </div>
    <div class="phone-feedback">
        @if (errorCodigoArea)
        {
            <small class="text-danger">Sin 0 inicial en el código de área</small>
        }
        else if (errorTelefono)
        {
            <small class="text-danger">Sin 15 al inicio del número</small>
        }
        else
        {
            <small class="text-muted">Cód. área (ej: 299) y número sin 15 (ej: 4123456). Total: @(codigoArea.Length + telefono.Length)/@LONGITUD_MAXIMA_TOTAL</small>
        }
    </div>
    <ValidationMessage For="@ValidationFor" class="validation-message" style="color: #dc3545;" />
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string IconName { get; set; } = "telephone";
    [Parameter] public string AriaLabel { get; set; } = "";
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string>>? ValidationFor { get; set; }
    [Parameter] public bool HasError { get; set; } = false;

    private const int LONGITUD_MAXIMA_TOTAL = 10;
    private const int LONGITUD_MINIMA_CODIGO_AREA = 2;
    private const int LONGITUD_MAXIMA_CODIGO_AREA = 4;
    private const int LONGITUD_MINIMA_TELEFONO = 6;
    private const int LONGITUD_MAXIMA_TELEFONO = 8;

    private ElementReference codigoAreaInputRef;
    private ElementReference telefonoInputRef;
    private bool _sanitizeAttached;
    private bool _pendingFocusCodigoArea = false;
    private bool _pendingFocusTelefono = false;
    private int _inputSeq;

    private string codigoArea = "";
    private string telefono = "";
    private bool errorCodigoArea = false;
    private bool errorTelefono = false;
    private int maxLengthCodigoArea = LONGITUD_MAXIMA_CODIGO_AREA;
    private int maxLengthTelefono = LONGITUD_MAXIMA_TELEFONO;

    private static readonly Regex IniciaConCeroRegex = new Regex(@"^0+", RegexOptions.Compiled);
    private static readonly Regex IniciaConQuinceRegex = new Regex(@"^15", RegexOptions.Compiled);

    private async Task OnCodigoAreaInput(ChangeEventArgs e)
    {
        // Ya viene solo dígitos desde JS sanitize (capture).
        string valor = e.Value?.ToString() ?? "";

        if (IniciaConCeroRegex.IsMatch(valor))
            valor = IniciaConCeroRegex.Replace(valor, "");

        int maxPermitido = Math.Max(
            LONGITUD_MINIMA_CODIGO_AREA,
            Math.Min(LONGITUD_MAXIMA_CODIGO_AREA, LONGITUD_MAXIMA_TOTAL - telefono.Length)
        );

        if (valor.Length > maxPermitido)
            valor = valor[..maxPermitido];

        var seq = ++_inputSeq;
        codigoArea = valor;
        errorCodigoArea = codigoArea.StartsWith("0");

        maxLengthTelefono = Math.Min(LONGITUD_MAXIMA_TELEFONO, LONGITUD_MAXIMA_TOTAL - codigoArea.Length);
        if (telefono.Length > maxLengthTelefono)
            telefono = telefono[..maxLengthTelefono];

        if (!errorCodigoArea && codigoArea.Length >= maxPermitido)
            _pendingFocusTelefono = true;

        await Task.Yield();
        if (seq != _inputSeq)
            return;

        await NotifyValueChanged();
    }

    private async Task OnTelefonoInput(ChangeEventArgs e)
    {
        string valor = e.Value?.ToString() ?? "";

        if (IniciaConQuinceRegex.IsMatch(valor))
            valor = IniciaConQuinceRegex.Replace(valor, "");

        int maxPermitido = Math.Min(LONGITUD_MAXIMA_TELEFONO, LONGITUD_MAXIMA_TOTAL - codigoArea.Length);

        if (valor.Length > maxPermitido)
            valor = valor[..maxPermitido];

        var seq = ++_inputSeq;
        telefono = valor;
        errorTelefono = telefono.StartsWith("15");

        maxLengthCodigoArea = Math.Max(
            LONGITUD_MINIMA_CODIGO_AREA,
            Math.Min(LONGITUD_MAXIMA_CODIGO_AREA, LONGITUD_MAXIMA_TOTAL - telefono.Length)
        );
        if (codigoArea.Length > maxLengthCodigoArea)
            codigoArea = codigoArea[..maxLengthCodigoArea];

        if (telefono.Length == 0)
            _pendingFocusCodigoArea = true;

        await Task.Yield();
        if (seq != _inputSeq)
            return;

        await NotifyValueChanged();
    }

    public bool EsValido =>
        !string.IsNullOrWhiteSpace(codigoArea) &&
        codigoArea.Length >= LONGITUD_MINIMA_CODIGO_AREA &&
        codigoArea.Length <= LONGITUD_MAXIMA_CODIGO_AREA &&
        !string.IsNullOrWhiteSpace(telefono) &&
        telefono.Length >= LONGITUD_MINIMA_TELEFONO &&
        telefono.Length <= LONGITUD_MAXIMA_TELEFONO &&
        (codigoArea.Length + telefono.Length) <= LONGITUD_MAXIMA_TOTAL &&
        !errorCodigoArea &&
        !errorTelefono;

    private async Task NotifyValueChanged()
    {
        await ValueChanged.InvokeAsync($"{codigoArea}{telefono}");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_sanitizeAttached)
        {
            try
            {
                await JS.InvokeVoidAsync("numericInput.attachSanitize", codigoAreaInputRef);
                await JS.InvokeVoidAsync("numericInput.attachSanitize", telefonoInputRef);
                _sanitizeAttached = true;
            }
            catch (JSException)
            {
            }
        }

        if (_pendingFocusCodigoArea)
        {
            _pendingFocusCodigoArea = false;
            await codigoAreaInputRef.FocusAsync();
        }
        else if (_pendingFocusTelefono)
        {
            _pendingFocusTelefono = false;
            await telefonoInputRef.FocusAsync();
        }
    }
}
