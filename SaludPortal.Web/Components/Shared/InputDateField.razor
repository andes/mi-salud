@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using SaludPortal.Web.Components.Icons
@using System.Globalization

<div class="input-field-group">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label for="@Id" class="input-label">@Label</label>
    }
    <div class="input-group @(HasError ? "invalid" : "")">
        <div class="input-icon">
            <Icon Name="@IconName" Size="18" Fill="#666" AriaLabel="@AriaLabel" />
        </div>
        <input type="date"
               id="@Id"
               value="@FormatValue()"
               @onchange="HandleChange"
               class="input-field"
               aria-label="@AriaLabel"
               min="1900-01-01"
               disabled="@Disabled" />
    </div>
    <ValidationMessage For="@ValidationFor" class="validation-message" style="color: #dc3545;" />
</div>

@code {
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string IconName { get; set; } = "calendar-check";
    [Parameter] public string AriaLabel { get; set; } = "";
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public DateTime Value { get; set; } = DateTime.MinValue;
    [Parameter] public EventCallback<DateTime> ValueChanged { get; set; }
    [Parameter] public Expression<Func<DateTime>>? ValidationFor { get; set; }
    [Parameter] public bool HasError { get; set; } = false;

    private string FormatValue()
        => Value == DateTime.MinValue ? "" : Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private async Task HandleChange(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        if (DateTime.TryParseExact(raw, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed))
        {
            await ValueChanged.InvokeAsync(parsed);
        }
    }
}
