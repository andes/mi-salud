@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using SaludPortal.Web.Components.Icons
@inject IJSRuntime JS

<div class="input-field-group">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="input-label">@Label</label>
    }
    <div class="input-group @(HasError ? "invalid" : "")">
        <div class="input-icon">
            <Icon Name="@IconName" Size="18" Fill="#666" AriaLabel="@AriaLabel" />
        </div>
        <input type="text"
               inputmode="numeric"
               class="input-field"
               placeholder="@Placeholder"
               @ref="_inputRef"
               value="@Value"
               @oninput="OnInput"
               onkeydown="numericInput.preventNonNumeric(event)"
               onpaste="numericInput.pasteDigitsOnly(event)"
               maxlength="@LONGITUD_MAXIMA"
               disabled="@Disabled" />
    </div>
    <div class="field-hint">
        <small class="text-muted">Solo números, hasta @LONGITUD_MAXIMA dígitos. Total: @(Value?.Length ?? 0)/@LONGITUD_MAXIMA</small>
    </div>
    <ValidationMessage For="@ValidationFor" class="validation-message" style="color: #dc3545;" />
</div>

@code {
    [Parameter] public string Label { get; set; } = "Número de trámite*";
    [Parameter] public string IconName { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "Ej: 00012345678";
    [Parameter] public string AriaLabel { get; set; } = "";
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string>>? ValidationFor { get; set; }
    [Parameter] public bool HasError { get; set; } = false;

    private const int LONGITUD_MAXIMA = 11;

    private ElementReference _inputRef;
    private bool _sanitizeAttached;
    private int _inputSeq;
    private string _latest = "";

    private async Task OnInput(ChangeEventArgs e)
    {
        // Valor ya sanitizado en JS (capture). Solo el último keystroke actualiza el modelo.
        _latest = e.Value?.ToString() ?? "";
        var seq = ++_inputSeq;
        await Task.Yield();
        if (seq != _inputSeq)
            return;

        await ValueChanged.InvokeAsync(_latest);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_sanitizeAttached)
            return;

        try
        {
            await JS.InvokeVoidAsync("numericInput.attachSanitize", _inputRef);
            _sanitizeAttached = true;
        }
        catch (JSException)
        {
        }
    }
}
