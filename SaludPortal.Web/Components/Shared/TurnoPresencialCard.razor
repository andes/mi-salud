@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using SaludPortal.Application.Models.Turnos
@using SaludPortal.Web.Components.Icons

@inject IJSRuntime JS

<div class="turno-futuro-card">
    <div class="turno-futuro-header">
        <span class="turno-futuro-badge">Presencial</span>
        <span class="turno-futuro-titulo">@Turno?.TipoPrestacion?.Term</span>
    </div>
    <div class="turno-futuro-body">
        <div class="turno-futuro-info-item">
            <span class="turno-futuro-label">
                <Icon Name="calendar-event" Size="16" Fill="#666" class="me-1" AriaLabel="Fecha y hora" />
                Fecha y hora del turno:
            </span>
            <span class="turno-futuro-value">@Turno?.FechaHora.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
  
        <div class="turno-futuro-info-item">
            <span class="turno-futuro-label">
                <Icon Name="person-vcard" Size="16" Fill="#666" class="me-1" AriaLabel="Profesional" />
                Profesional@(Turno?.Profesionales?.Count > 1 ? "es" : ""):
            </span>
            @if (Turno?.Profesionales != null && Turno.Profesionales.Any())
            {
                <ul class="turno-futuro-profesionales">
                    @foreach (var p in Turno.Profesionales)
                    {
                        <li>@p.Apellido, @p.Nombre</li>
                    }
                </ul>
            }
            else
            {
                <span class="turno-futuro-value">No se ha asignado un profesional</span>
            }
        </div>

        <div class="turno-futuro-info-item">
            <span class="turno-futuro-label">
                <Icon Name="hospital" Size="16" Fill="#666" class="me-1" AriaLabel="Lugar" />
                Lugar:
            </span>
            <span class="turno-futuro-value">@Turno?.Organizacion?.Nombre</span>
        </div>
    </div>
    <div class="turno-futuro-footer">
        <button class="turno-futuro-cancel-button" @onclick="HandleCancel" @onclick:stopPropagation="true"
                title="Cancelar turno">
            <Icon Name="cancelar-turno" Size="20" Fill="#dc3545" AriaLabel="Cancelar" />
            <span>Cancelar</span>
        </button>
    </div>
</div>

@code {
    [Parameter]
    public Turno Turno { get; set; } = new();

    [Parameter]
    public EventCallback<Turno> OnCancel { get; set; }

    private async Task HandleCancel()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync(Turno);
        }
    }

    private async Task HandleJoin()
    {
        if (!string.IsNullOrWhiteSpace(Turno.WebexLinks?.patientLink))
        {
            await JS.InvokeVoidAsync("open", Turno.WebexLinks.patientLink, "_blank", "noopener,noreferrer");
        }
    }
}
