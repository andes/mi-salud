@using Microsoft.AspNetCore.Components
@using SaludPortal.Web.Services

@inject TelemetryService Telemetry
@inject NavigationManager Navigation

<div class="page-header-with-back">
    <PageHeader Title="@Title" Subtitle="@Subtitle" />
    <div class="page-header-with-back__back">
        <ButtonPrimaryOutlined OnClick="HandleBack"
                               Text="@BackText"
                               AriaLabel="@BackAriaLabel"
                               Size="sm" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter, EditorRequired]
    public string BackHref { get; set; } = string.Empty;

    [Parameter]
    public string BackText { get; set; } = "VOLVER";

    [Parameter, EditorRequired]
    public string BackAriaLabel { get; set; } = string.Empty;

    private void HandleBack()
    {
        var currentPath = new Uri(Navigation.Uri).AbsolutePath;
        _ = Telemetry.TrackClickAsync("volver", currentPath, new { backHref = BackHref });
        Navigation.NavigateTo(BackHref);
    }
}
