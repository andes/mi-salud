@using SaludPortal.Application.Models.Laboratorios
@using Microsoft.AspNetCore.Components
@using SaludPortal.Web.Components.Icons

@inject TelemetryService Telemetry

<div class="laboratorio-card" @onclick="HandleDownloadClick" title="Descargar" tabindex="0">
    <div class="laboratorio-header">
        <div class="laboratorio-header-info">
            @if (!string.IsNullOrWhiteSpace(Laboratorio.Fecha))
            {
                <span class="laboratorio-fecha">@Laboratorio.Fecha</span>
            }
            <span class="laboratorio-tipo">Informe De Laboratorio</span>
        </div>
        <div class="laboratorio-actions" title="Descargar PDF">
            <div class="laboratorio-action">
                <Icon Name="cloud-download" Size="24" Fill="#00374c" class="download-icon" AriaLabel="Descargar" />
            </div>
        </div>
    </div>
    <div class="laboratorio-body">
        @if (!string.IsNullOrWhiteSpace(Laboratorio.Laboratorio))
        {
            <div class="laboratorio-info">
                <span class="laboratorio-label">
                    <Icon Name="hospital" Size="16" Fill="#666" class="me-1" AriaLabel="Institución" />
                    Institución:
                </span>
                <span class="laboratorio-value">@Laboratorio.Laboratorio</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Laboratorio.MedicoSolicitante))
        {
            <div class="laboratorio-info">
                <span class="laboratorio-label">Solicitante:</span>
                <span class="laboratorio-value">@Laboratorio.MedicoSolicitante</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public LaboratorioModel Laboratorio { get; set; } = new();

    [Parameter]
    public EventCallback<LaboratorioModel> OnDownload { get; set; }

    private async Task HandleDownloadClick()
    {
        if (OnDownload.HasDelegate && !string.IsNullOrEmpty(Laboratorio.IdProtocolo))
        {
            await OnDownload.InvokeAsync(Laboratorio);
            _ = Telemetry.TrackLaboratorioPdfDownloadAsync(Laboratorio.IdProtocolo);
        }
    }
}
