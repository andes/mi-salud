@using AndesServices.Entities
@using Microsoft.AspNetCore.Components.Authorization
@using SaludPortal.Application.Models.Turnos
@using SaludPortal.Application.UseCases.Turnos
@using SaludPortal.Web.Components.Shared

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BlazorSpinner.SpinnerService _spinnerService
@inject MessageService MessageService
@inject RegistrarTurnoUseCase _registrarTurnoUseCase
@inject TelemetryService Telemetry

@inherits AuthenticatedComponentBase

<div>
    <h2>CONFIRMAR TURNO</h2>
    <h3>
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-calendar" viewBox="0 0 16 16">
            <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z" />
        </svg> Detalles del turno
    </h3>
</div>
<div class="d-inline-flex flex-lg-row" style="background:#edfce2;color:#000;width:100%;">
    <div class="p-sm-2 flex-shrink-1"></div>
    <div class="p-lg-10 flex-fill flex-grow-1" style="padding:5px; width:100%; margin:5px;">
        <p>
            <div><label><strong>Prestación</strong></label></div>
            <div><label>@TurnoDisponible.TipoPrestacion</label></div>
        </p>
        <hr />
        <p>
            <div><label><strong>Paciente</strong></label></div>
            <div><label>@Paciente</label></div>
        </p>
        <hr />
        <p>
            <div><label><strong>Fecha y hora del turno</strong></label></div>
            <div><label>@TurnoDisponible.FechaHora.ToString("dd/MM/yyyy HH:mm")</label></div>
        </p>
        <hr />
        <p>
            <div><label><strong>@TurnoDisponible.NombreEfector</strong></label></div>
            <div><label>@TurnoDisponible.DomicilioEfector</label></div>
        </p>
        <hr />
    </div>
</div>
<br />
<br />
<div style="display: flex; justify-content: space-between; width: 100%;">
    <button @onclick="Close" class="btn btn-outline-primary" title="Cerrar">Cerrar</button>
    <button @onclick="() => ConfirmarTurno()" class="btn btn-primary" title="Confirmar">Confirmar</button>
</div>
@code {
    [CascadingParameter] BlazoredModalInstance ModalConfirmarTurno { get; set; } = default!;
    [CascadingParameter] IModalService ModalService { get; set; } = default!;

    [Parameter] public string Paciente { get; set; }
    [Parameter] public TurnoDisponible TurnoDisponible { get; set; }

    private async Task Close()
    {
        _ = Telemetry.TrackClickAsync("turnos/confirmar-cerrar-modal");
        await ModalConfirmarTurno.CloseAsync();
    }

    private async Task ConfirmarTurno()
    {
        var token = BackendToken;
        if (string.IsNullOrEmpty(token))
            return;

        var pacienteId = PacienteId;
        if (string.IsNullOrEmpty(pacienteId))
            return;

        _ = Telemetry.TrackClickAsync("turnos/confirmar", metadata: new { turnoId = TurnoDisponible.Id, efector = TurnoDisponible.NombreEfector });

        _spinnerService.Show();
        bool resultado = await _registrarTurnoUseCase.EjecutarAsync(pacienteId, TurnoDisponible);
        _spinnerService.Hide();

        if (resultado)
        {
            await ModalConfirmarTurno.CloseAsync();
            MessageService.Title = "Turno confirmado";
            MessageService.Content = "El turno ha sido confirmado exitosamente.";
            Nav.NavigateTo("/turnosmensajeconfirma");

        }
        else
        {
            await ModalConfirmarTurno.CloseAsync();
            MessageService.Title = "Turno no confirmado";
            MessageService.Content = "No se pudo confirmar el turno. Posiblemente el turno ya no se encontraba disponible. Por favor, intente nuevamente.";
            Nav.NavigateTo("/turnosmensajenoconfirma");
        }
    }
}