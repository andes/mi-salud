@using Microsoft.AspNetCore.Authorization
@using SaludPortal.Web.Models.AccountViewModels
@model LoginViewModel

<div class="login-page">
    <div class="container">
        <div class="row top-buffer">

            <div>esto es una prueba</div>
            <div class="col"></div>
            <div class="col-sm-6">
                <form asp-route="Login">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="login-container">
                        <h2>Login</h2>
                        <partial name="_ValidationSummary" />
                        <div class="form-group">
                            <label asp-for="email"></label>
                            <input class="form-control" placeholder="Usuario" asp-for="email" autofocus>
                        </div>
                        <div class="form-group">
                            <label asp-for="password"></label>
                            <input type="password" class="form-control" placeholder="Contraseña" asp-for="password" autocomplete="off">
                        </div>                        
                            <div class="form-group">
                                <div class="form-check">
                                    <input class="form-check-input" asp-for="RememberLogin">
                                    <label class="form-check-label" asp-for="RememberLogin">
                                        Remember me
                                    </label>
                                </div>
                            </div>
                        <div>
                            <p>The default users are alice/bob, password: Pass123$</p>
                        </div>
                        <button class="btn btn-primary" name="button" value="login">Login</button>
                    </div>
                </form>
            </div>
            <div class="col"></div>
        </div>
    </div>
</div>