@using AndesServices.Entities
@using Blazored.Modal
@using Blazored.Modal.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using SaludPortal.Application.Models.GrupoFamiliar
@using SaludPortal.Application.UseCases.Consentimiento
@using SaludPortal.Web.Components.Icons
@using SaludPortal.Web.Components.Modals
@using SaludPortal.Web.Services
@inject NavigationManager Nav
@inject TelemetryService Telemetry
@inject IJSRuntime JS
@inject ObtenerConsentimientosUseCase ObtenerConsentimientosUseCase
@inject PerfilActivoService PerfilActivo
@implements IDisposable

<CascadingAuthenticationState>
    <div class="top-row ps-3 navbar navbar-dark @(EsPerfilFamiliar ? "top-row--con-volver" : null)">
        <div class="container-fluid">
            <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle @(EsPerfilFamiliar ? "perfil-btn--familiar" : "perfil-btn--titular")"
                        type="button"
                        id="dropdownMenuMiCuenta"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        title="@TituloPerfil">
                    @NombrePerfilActivo
                </button>
                <ul class="dropdown-menu">
                    <li>
                        <a href="/mis-datos" class="dropdown-item" @onclick="OnMisDatosClickAsync"><Icon Name="mis-datos" Fill="#000" AriaLabel="Mis datos" /> Mis datos</a>
                    </li>
                    <li>
                        <button type="button" class="dropdown-item" @onclick="AbrirActuarComoFamiliarAsync">
                            <Icon Name="arrow-left-right" Fill="#000" AriaLabel="Actuar como un familiar" /> Actuar como un familiar
                        </button>
                    </li>
                    <li>
                        <form action="/logout" method="post">
                            <button type="submit" class="dropdown-item" @onclick="OnLogoutClickAsync"><Icon Name="logout" Fill="#000" AriaLabel="Cerrar sesión" /> Cerrar Sesión</button>
                        </form>
                    </li>
                </ul>
            </div>
            @if (EsPerfilFamiliar)
            {
                <button type="button"
                        class="btn btn-sm btn-volver-perfil mt-2"
                        title="Volver a mi perfil"
                        @onclick="VolverAMiPerfilAsync">
                    Volver a mi perfil
                </button>
            }
        </div>
    </div>

    <input type="checkbox" title="Menu" class="navbar-toggler" @bind="isNavMenuOpen" />

    <div class="nav-scrollable">
        <nav class="nav flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" alt="Inicio" title="Inicio" @onclick='() => OnNavClick("menu/inicio", "/")'>
                    <span class="bi bi-house-door-fill"></span> Inicio
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="misvacunas" title="Mis vacunas" @onclick='() => OnNavClick("menu/mis-vacunas", "/misvacunas")'>
                    <span class="bi bi-syringe"></span>Mis vacunas
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="GrupoFamiliar" title="Grupo familiar" @onclick='() => OnNavClick("menu/grupo-familiar", "/GrupoFamiliar")'>
                    <span class="bi bi-people-group"></span> Grupo familiar
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="HistoriaSalud" title="Historia de salud" @onclick='() => OnNavClick("menu/historia-salud", "/HistoriaSalud")'>
                    <span class="bi bi-clipboard2-heart"></span> Historia de salud
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="MisLaboratorios" title="Mis laboratorios" @onclick='() => OnNavClick("menu/mis-laboratorios", "/MisLaboratorios")'>
                    <span class="bi bi-flask-vial"></span> Mis laboratorios
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="MisRecetas" title="Mis recetas" @onclick='() => OnNavClick("menu/mis-recetas", "/MisRecetas")'>
                    <span class="bi bi-file-medical"></span> Mis recetas
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Misturnos" title="Mis turnos" @onclick='() => OnNavClick("menu/mis-turnos", "/Misturnos")'>
                    <span class="bi bi-turnos"></span> Mis turnos
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Farmaciasdeturno" title="Farmacias de turno" @onclick='() => OnNavClick("menu/farmacias-turno", "/Farmaciasdeturno")'>
                    <span class="bi bi-farmaciasturno"></span> Farmacias de turno
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="centros-salud" title="Centros de Salud" @onclick='() => OnNavClick("menu/centros-salud", "/centros-salud")'>
                    <span class="bi bi-hospital-fill"></span> Centros de Salud
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="mis-programas" title="Mis Programas" @onclick='() => OnNavClick("menu/mis-programas", "/mis-programas")'>
                    <span class="bi bi-clipboard2-heart"></span> Mis Programas
                </NavLink>
            </div>
        </nav>
    </div>
</CascadingAuthenticationState>
@code {

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    [CascadingParameter] private IModalService Modal { get; set; } = default!;

    private string? userName;
    private string? NombreTitular;
    private string? _titularPacienteId;
    private FamiliarPerfil? _familiar;
    private bool isNavMenuOpen;

    private bool EsPerfilFamiliar => _familiar != null && !string.IsNullOrWhiteSpace(_familiar.Id);

    private string NombrePerfilActivo =>
        EsPerfilFamiliar
            ? (_familiar!.NombreCompleto ?? "Familiar")
            : (NombreTitular ?? "Usuario");

    private string TituloPerfil
    {
        get
        {
            if (!EsPerfilFamiliar)
                return NombreTitular ?? "Usuario";

            var nombre = _familiar!.NombreCompleto ?? "Familiar";
            return _familiar.Edad is int edad ? $"{nombre} ({edad} años)" : nombre;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is null) return;
        var auth = await AuthStateTask;
        userName = auth.User.Identity?.IsAuthenticated == true ? auth.User.Identity.Name : null;
        var alias = auth.User.GetAlias();
        var nombre = auth.User.GetNombre();
        var apellido = auth.User.GetApellido();
        NombreTitular = Paciente.GetDisplayName(nombre, apellido, alias);
        _titularPacienteId = auth.User.GetPacienteId();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        PerfilActivo.Changed += OnPerfilChanged;
        await CargarPerfilAsync();
    }

    private async Task CargarPerfilAsync()
    {
        _familiar = await PerfilActivo.GetAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnPerfilChanged() => _ = InvokeAsync(CargarPerfilAsync);

    private async Task VolverAMiPerfilAsync()
    {
        if (!EsPerfilFamiliar)
            return;

        TrackClick("account/volver-perfil", Nav.Uri);
        await CerrarMenuCuentaAsync();
        await PerfilActivo.SalirAsync();
        _familiar = null;
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private async Task AbrirActuarComoFamiliarAsync()
    {
        TrackClick("account/actuar-familiar", Nav.Uri);
        await CerrarMenuCuentaAsync();

        var parameters = new ModalParameters()
            .Add(nameof(ActuarComoFamiliarModal.TitularPacienteId), _titularPacienteId ?? "")
            .Add(nameof(ActuarComoFamiliarModal.NombreTitular), NombreTitular ?? "Usuario");

        var options = new ModalOptions
        {
            Size = ModalSize.Medium,
            Position = ModalPosition.TopCenter,
            HideCloseButton = false,
            HideHeader = true
        };

        Modal.Show<ActuarComoFamiliarModal>(parameters, options);
    }

    private async Task OnMisDatosClickAsync()
    {
        TrackClick("account/mis-datos", "/mis-datos");
        await CerrarMenuCuentaAsync();
    }

    private async Task OnLogoutClickAsync()
    {
        TrackClick("account/logout", "/logout");
        await CerrarMenuCuentaAsync();
    }

    private async Task CerrarMenuCuentaAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("misaludAccountMenu.hide");
        }
        catch (JSException)
        {
        }
    }

    private void OnNavClick(string target, string route)
    {
        isNavMenuOpen = false;
        _ = Telemetry.TrackClickAsync(target, route, new { component = "NavMenu" });
    }

    private void TrackClick(string target, string route)
    {
        _ = Telemetry.TrackClickAsync(target, route, new { component = "AccountMenu" });
    }

    public void Dispose()
    {
        PerfilActivo.Changed -= OnPerfilChanged;
    }
}
<script src="../js/auth.js"></script>
