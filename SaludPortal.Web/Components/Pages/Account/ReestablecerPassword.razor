@page "/reestablecer-password"
@using SaludPortal.Web.Models
@using SaludPortal.Web.Components.Icons
@using SaludPortal.Web.Components.Shared
@using SaludPortal.Application.UseCases.Account
@using Microsoft.AspNetCore.Components.Forms

@layout LoginLayout
@attribute [AllowAnonymous]

@inject ReestablecerContraseniaUseCase ReestablecerContraseniaUseCase
@inject NavigationManager Nav
@inject ILogger<ReestablecerPassword> _logger
@inject TelemetryService Telemetry

<PageTitle>Restablecer contraseña - Mi Salud</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h2 class="login-title">Recuperar Contraseña</h2>
        </div>

        <div class="login-body">
            @if (mensajeExito)
            {
                <div class="login-success" role="alert">
                    <Icon Name="check-circle" Size="20" Fill="#28a745" class="me-2" AriaLabel="Éxito" />
                    <span>Se ha reestablecido la contraseña con éxito</span>
                </div>
                <ButtonPrimary Type="button"
                               Text="Ir al inicio de sesión"
                               OnClick="GoToLogin"
                               AriaLabel="Ir al inicio de sesión" />
            }
            else
            {
                <p class="login-description">
                    Ingrese los datos para restablecer su contraseña.
                </p>

                <EditForm Model="_model" OnValidSubmit="OnSubmit" class="login-form" @ref="_editForm">
                    <DataAnnotationsValidator />

                    <InputTextField @bind-Value="_model.Email"
                                    Id="txtEmail"
                                    Type="email"
                                    IconName="envelope"
                                    Placeholder="Ingresa tu email"
                                    AriaLabel="Correo Electrónico"
                                    Disabled="@_busy"
                                    HasError="@HasFieldError(nameof(_model.Email))"
                                    ValidationFor="@(() => _model.Email)" />

                    <InputTextField @bind-Value="_model.Codigo"
                                    Id="txtCodigo"
                                    Type="text"
                                    IconName="key"
                                    Placeholder="Ingresa tu código de activación"
                                    AriaLabel="Código de activación"
                                    Disabled="@_busy"
                                    HasError="@HasFieldError(nameof(_model.Codigo))"
                                    ValidationFor="@(() => _model.Codigo)" />

                    <InputTextField @bind-Value="_model.Password"
                                    Id="txtPassword"
                                    Type="password"
                                    IconName="lock"
                                    Placeholder="Ingresa tu contraseña"
                                    AriaLabel="Contraseña"
                                    Disabled="@_busy"
                                    HasError="@HasFieldError(nameof(_model.Password))"
                                    ValidationFor="@(() => _model.Password)" />

                    <InputTextField @bind-Value="_model.ConfirmPassword"
                                    Id="txtConfirmPassword"
                                    Type="password"
                                    IconName="lock"
                                    Placeholder="Confirma tu contraseña"
                                    AriaLabel="Confirmar Contraseña"
                                    Disabled="@_busy"
                                    HasError="@HasFieldError(nameof(_model.ConfirmPassword))"
                                    ValidationFor="@(() => _model.ConfirmPassword)" />

                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="login-error" role="alert">
                            <Icon Name="exclamation-triangle" Size="18" Fill="#dc3545" class="me-2" AriaLabel="Error" />
                            <span>@_error</span>
                        </div>
                    }

                    <ButtonPrimary Type="submit"
                                   Text="@(_busy ? "Enviando..." : "Enviar")" 
                                   Disabled="@_busy" 
                                   AriaLabel="@(_busy ? "Enviando..." : "Enviar")" />
                </EditForm>
            }
        </div>

        <div class="login-footer">
            <div class="login-footer-link">
                <a href="/login" @onclick="GoToLogin" @onclick:preventDefault class="login-link">Volver al inicio de sesión</a>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, SupplyParameterFromQuery]
    public string? Email { get; set; }

    [Parameter, SupplyParameterFromQuery]
    public string? Codigo { get; set; }

    private readonly ReestablecerPasswordViewModel _model = new();
    private string? _error;
    private bool _busy;
    private bool mensajeExito = false;
    private EditForm? _editForm;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Email))
        {
            _model.Email = Email;
        }
        if (!string.IsNullOrWhiteSpace(Codigo))
        {
            _model.Codigo = Codigo;
        }

        _model.Email = Email;
    }

    private bool HasFieldError(string fieldName)
    {
        return _editForm?.EditContext?.GetValidationMessages(new FieldIdentifier(_model, fieldName)).Any() ?? false;
    }

    private async Task OnSubmit()
    {
        _error = null;
        _busy = true;

        try
        {
            await Telemetry.TrackClickAsync("reestablecerpassword/submit", "/reestablecer-password");
            var result = await ReestablecerContraseniaUseCase.EjecutarAsync(
                _model.Email, _model.Codigo, _model.Password, _model.ConfirmPassword);

            if (result.success)
            {
                mensajeExito = true;
            }
            else
            {
                _error = result.error;
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Se produjo un error al procesar la solicitud de reestablecer contraseña");
            _error = "Ocurrió un error al procesar su solicitud. Por favor, intente nuevamente más tarde.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task GoToLogin()
    {
        await Telemetry.TrackClickAsync("reestablecerpassword/ir-login", "/reestablecer-password");
        Nav.NavigateTo("/login");
    }
}
