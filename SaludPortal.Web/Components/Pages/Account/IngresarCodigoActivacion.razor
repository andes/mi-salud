@page "/ingresar-codigo-activacion"
@layout LoginLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer

@using SaludPortal.Web.Models.AccountViewModels
@using SaludPortal.Web.Components.Icons
@using SaludPortal.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using SaludPortal.Application.UseCases.Account
@using System.Linq

@inject NavigationManager Nav
@inject ValidarCodigoActivacionUseCase ValidarCodigoActivacionUseCase
@inject ILogger<IngresarCodigoActivacion> Logger
@inject TelemetryService Telemetry

<PageTitle>Activar cuenta - Mi Salud</PageTitle>

<div class="container">
    <div class="card">
        <div class="header">
            <h2 class="title">Activar cuenta</h2>
        </div>

        <div class="body">
            @if (CodigoEnviado)
            {
                <div class="alert alert-info mb-4" role="alert">
                    <Icon Name="info-circle" Size="18" Fill="#0dcaf0" class="me-2" AriaLabel="Información" />
                    <span>Te enviamos un código de activación al correo registrado.</span>
                </div>
            }

            <EditForm Model="_model" OnValidSubmit="DoValidarCodigo" class="form" @ref="_editForm">
                <DataAnnotationsValidator />

                <div class="form-content">
                    <InputTextField @bind-Value="_model.Email"
                                    Id="txtEmail"
                                    Type="email"
                                    IconName="envelope"
                                    Label="Correo electrónico*"
                                    Placeholder="Correo electrónico"
                                    MaxLength="50"
                                    AriaLabel="Correo electrónico"
                                    HasError="@HasFieldError(nameof(_model.Email))"
                                    ValidationFor="@(() => _model.Email)" />

                    <InputTextField @bind-Value="_model.CodigoActivacion"
                                    Id="txtCodigoActivacion"
                                    Type="text"
                                    IconName="key"
                                    Label="Código de activación*"
                                    Placeholder="Código de activación"
                                    AriaLabel="Código de activación"
                                    HasError="@HasFieldError(nameof(_model.CodigoActivacion))"
                                    ValidationFor="@(() => _model.CodigoActivacion)" />
                </div>

                @if (_errors.Count > 0)
                {
                    <div class="error" role="alert">
                        <div class="d-flex align-items-start mb-2">
                            <Icon Name="exclamation-triangle" Size="18" Fill="#dc3545" class="me-2 mt-1" AriaLabel="Error" />
                        </div>
                        <ul class="mb-0">
                            @foreach (var error in _errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_success))
                {
                    <div class="success" role="alert">
                        <Icon Name="check-circle" Size="18" Fill="#28a745" class="me-2" AriaLabel="Éxito" />
                        <span>@_success</span>
                    </div>
                }

                <ButtonPrimary Type="submit"
                               Text="@(_busy ? "Validando..." : "Activar cuenta")"
                               Disabled="@_busy"
                               AriaLabel="@(_busy ? "Validando..." : "Activar cuenta")" />
            </EditForm>
        </div>

        <div class="footer">
            <div class="footer-link">
                <span class="footer-text">¿Ya tenés tu cuenta activa?</span>
                <a href="/login" @onclick="GoToLogin" @onclick:preventDefault class="link">Iniciar sesión</a>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "codigoEnviado")]
    public bool CodigoEnviado { get; set; } = false;

    private readonly IngresarCodigoActivacionViewModel _model = new();
    private List<string> _errors = new();
    private string? _success;
    private bool _busy;
    private EditForm? _editForm;

    private bool HasFieldError(string fieldName)
    {
        return _editForm?.EditContext?.GetValidationMessages(new FieldIdentifier(_model, fieldName)).Any() ?? false;
    }

    private async Task DoValidarCodigo()
    {
        _busy = true;
        _errors.Clear();
        _success = null;

        try
        {
            await Telemetry.TrackClickAsync("activacion/submit", "/ingresar-codigo-activacion");
            var result = await ValidarCodigoActivacionUseCase.EjecutarAsync(_model.Email, _model.CodigoActivacion);
            if (!result.valid)
            {
                _errors.Add(result.error ?? "Error al validar el código de activación.");
                return;
            }

            if (result.restablecerPassword)
            {
                Nav.NavigateTo($"/reestablecer-password?email={Uri.EscapeDataString(_model.Email)}&codigo={Uri.EscapeDataString(_model.CodigoActivacion)}", forceLoad: true);
            }
            else
            {
                _success = "Código validado. Redirigiendo...";

                StateHasChanged();
                await Task.Delay(2000);
                Nav.NavigateTo($"/crear-contrasenia?email={Uri.EscapeDataString(_model.Email)}&codigo={Uri.EscapeDataString(_model.CodigoActivacion)}", forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            _errors.Add("Error al validar el código de activación.");
            Logger.LogError(ex, "Error al validar código de activación");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task GoToLogin()
    {
        await Telemetry.TrackClickAsync("activacion/volver-login", "/ingresar-codigo-activacion");
        Nav.NavigateTo("/login", true);
    }
}
