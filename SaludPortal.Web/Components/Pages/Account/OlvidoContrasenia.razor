@page "/olvidocontrasenia"
@page "/recuperocontrasenia"
@using System.ComponentModel.DataAnnotations
@using SaludPortal.Web.Components.Icons
@using SaludPortal.Web.Components.Shared
@using SaludPortal.Web.Models
@using SaludPortal.Application.UseCases.Account
@using Microsoft.AspNetCore.Components.Forms

@layout LoginLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inject SolicitarRecuperacionContraseniaUseCase SolicitarRecuperacionContraseniaUseCase
@inject NavigationManager Nav
@inject ILogger<OlvidoContrasenia> _logger
@inject TelemetryService Telemetry

<PageTitle>Recuperar contraseña - Mi Salud</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h2 class="login-title">Recuperar Contraseña</h2>
        </div>

        <div class="login-body">
            @if (mensajeExito)
            {
                <div class="login-success" role="alert">
                    <Icon Name="check-circle" Size="20" Fill="#28a745" class="me-2" AriaLabel="Éxito" />
                    <span>Se envió el código de activación de su cuenta al correo @_model.Email</span>
                </div>
                <ButtonPrimary Type="button"
                               Text="Ingresar Código de Activación"
                               AriaLabel="Ingresar Código de Activación"
                               OnClick="IrAReestablecerPassword" />
            }
            else
            {
                <p class="login-description">
                    Ingrese su correo electrónico y le enviaremos un código para restablecer su contraseña.
                </p>

                <EditForm Model="_model" OnValidSubmit="OnSubmit" class="login-form" @ref="_editForm">
                    <DataAnnotationsValidator />

                    <InputTextField @bind-Value="_model.Email"
                                    Id="txtEmail"
                                    Type="email"
                                    IconName="envelope"
                                    Placeholder="Ingresa tu email"
                                    AriaLabel="Correo Electrónico"
                                    Disabled="@_busy"
                                    HasError="@HasFieldError(nameof(_model.Email))"
                                    ValidationFor="@(() => _model.Email)" />

                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="login-error" role="alert">
                            <Icon Name="exclamation-triangle" Size="18" Fill="#dc3545" class="me-2" AriaLabel="Error" />
                            <span>@_error</span>
                        </div>
                    }

                    <ButtonPrimary Type="submit"
                                   Text="@(_busy ? "Enviando..." : "Enviar")" 
                                   Disabled="@_busy"
                                   AriaLabel="@(_busy ? "Enviando..." : "Enviar")" />
                </EditForm>
            }
        </div>

        <div class="login-footer">
            <div class="login-footer-link">
                <a href="/login" @onclick="GoToLogin" @onclick:preventDefault class="login-link">Volver al inicio de sesión</a>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly OlvidoContraseniaViewModel _model = new();
    private string? _error;
    private bool _busy;
    private bool mensajeExito = false;
    private EditForm? _editForm;

    private bool HasFieldError(string fieldName)
    {
        return _editForm?.EditContext?.GetValidationMessages(new FieldIdentifier(_model, fieldName)).Any() ?? false;
    }

    private async Task OnSubmit()
    {
        _error = null;
        _busy = true;

        try
        {
            await Telemetry.TrackClickAsync("olvidocontrasenia/submit", "/olvidocontrasenia");
            var result = await SolicitarRecuperacionContraseniaUseCase.EjecutarAsync(_model.Email);

            if (result.success)
            {
                Nav.NavigateTo($"/reestablecer-password?email={Uri.EscapeDataString(_model.Email)}");
                mensajeExito = true;
            }
            else
            {
                _error = result.error;
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Se produjo un error al procesar la solicitud de olvide contraseña");
            _error = "Ocurrió un error al procesar su solicitud. Por favor, intente nuevamente más tarde.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task IrAReestablecerPassword(MouseEventArgs _)
    {
        await Telemetry.TrackClickAsync("olvidocontrasenia/ir-reestablecer", "/olvidocontrasenia");
        Nav.NavigateTo("/reestablecer-password");
    }

    private async Task GoToLogin()
    {
        await Telemetry.TrackClickAsync("olvidocontrasenia/volver-login", "/olvidocontrasenia");
        Nav.NavigateTo("/login");
    }
}
