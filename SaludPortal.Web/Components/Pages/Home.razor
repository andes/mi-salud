@page "/home"

@using SaludPortal.Application.UseCases.Auth
@using SaludPortal.Web.Components.Modals

@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject ValidarConexionXroadssUseCase ValidarConexionXroadssUseCase
@inject AppToastService ToastService
@inject ILogger<Home> Logger
@inject TelemetryService Telemetry


<PageTitle>Inicio - Mi Salud</PageTitle>
<div class="container">
    
    <h1>El cuidado de mi <strong>salud</strong> comienza <strong>acá</strong></h1>
    <div class="home-subtitle">
        Tu Historia Clínica está protegida. Enterate cuándo puede ser consultada &ensp;
        <button class="btn-homeprivacidad" @onclick="() => ShowModal()">Quiénes pueden verla</button>
    </div>
    <div class="home-img-banner">
        <img 
            srcset="../images/bannermisalud-270x296.png 270w,
                    ../images/bannermisalud-540x593.png 540w,
                    ../images/bannermisalud-810x889.png 810w,
                    ../images/bannermisalud-1080x1185.png 1080w"
            sizes="(max-width: 640px) 100vw,
                   (max-width: 1024px) 90vw,
                   1080px"
            src="../images/bannermisalud-1080x1185.png"
            alt="Mi Salud Banner" />

    </div>
</div>
@code {
    private bool _xroadssConnectionChecked;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    [CascadingParameter] IModalService Modal { get; set; } = default!;

    private async Task ShowModal()
    {
        _ = Telemetry.TrackClickAsync("home/privacidad", "/home");

        var options = new ModalOptions()
        {
            Class = "privacidad-modal",
            Size = ModalSize.Large,
            Position = ModalPosition.TopCenter,
            HideCloseButton = false,
            HideHeader = true,
        };
        
        Modal.Show<Privacidad>(options);
    }
    
    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationState != null)
        {
            var authState = await AuthenticationState;
            if (authState.User.Identity?.IsAuthenticated == false)
            {
                Nav.NavigateTo("/login", true);
            }
        }
        else
        {
            Nav.NavigateTo("/login", true);
        }

        await CheckXroadssConnectionAsync();
    }

    private async Task CheckXroadssConnectionAsync()
    {
        if (_xroadssConnectionChecked)
        {
            return;
        }

        _xroadssConnectionChecked = true;

        var xroadssConnection = await ValidarConexionXroadssUseCase.EjecutarAsync();
        if (!xroadssConnection)
        {
            ToastService.ShowError("Error al validar conexión con xroadss.", 10000);
        }
    }
}