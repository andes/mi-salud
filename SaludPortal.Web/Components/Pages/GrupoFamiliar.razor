@page "/grupofamiliar"
@rendermode InteractiveServer

@using AndesServices.Entities
@using SaludPortal.Web.Components.Shared
@using SaludPortal.Application.Models.GrupoFamiliar
@using SaludPortal.Application.UseCases.GrupoFamiliar
@using PacienteEntity = AndesServices.Entities.Paciente

@inherits AuthenticatedComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BlazorSpinner.SpinnerService _spinnerService
@inject ObtenerGrupoFamiliarUseCase _obtenerGrupoFamiliarUseCase
@inject ObtenerFamiliaresElegiblesUseCase _obtenerFamiliaresElegiblesUseCase

<PageTitle>Grupo familiar - Mi Salud</PageTitle>

<div class="grupo-familiar-container">
    <PageHeaderWithBack Title="Grupo Familiar"
                        Subtitle="Información personal y relaciones familiares"
                        BackHref="/"
                        BackAriaLabel="Volver al Inicio" />

    @if (!string.IsNullOrWhiteSpace(_mensaje))
    {
        <div class="alert alert-info" role="status">@_mensaje</div>
    }

    @if (unPaciente != null)
    {
        <div class="paciente-section">
            <SectionTitle Title="Mis Datos" />
            <PacienteInfoCard Paciente="unPaciente" />
        </div>

        <div class="relaciones-section">
            <SectionTitle Title="Relaciones Familiares" />

            @if (_elegibles.Count > 0)
            {
                <p class="elegibles-hint">
                    Podés operar como un hijo/a menor de @ObtenerFamiliaresElegiblesUseCase.EdadMaximaExclusive años
                    (turnos, laboratorios y datos de contacto).
                </p>
            }

            @if (unPaciente.relaciones != null && unPaciente.relaciones.Any())
            {
                <div class="relaciones-grid">
                    @foreach (var relacion in unPaciente.relaciones)
                    {
                        @if (relacion != null)
                        {
                            var familiar = BuscarElegible(relacion);
                            var esElegible = familiar != null;
                            var esActivo = esElegible
                                && EsPerfilFamiliar
                                && string.Equals(FamiliarActivo?.Id, familiar!.Id, StringComparison.OrdinalIgnoreCase);

                            <RelacionCard Relacion="relacion"
                                          EsElegible="esElegible"
                                          EsPerfilActivo="esActivo"
                                          OnUsarPerfil="() => UsarPerfilAsync(familiar!)"
                                          OnVolverAMiPerfil="SalirDeFamiliarAsync" />
                        }
                    }
                </div>
            }
            else
            {
                <EmptyState Message="No se encontraron relaciones familiares registradas." />
            }
        </div>
    }
    else
    {
        <EmptyState Message="No se pudo cargar la información del paciente." />
    }
</div>

@code {
    private PacienteEntity? unPaciente;
    private List<FamiliarPerfil> _elegibles = [];
    private string? _mensaje;

    protected override async Task OnAuthenticatedInitializedAsync()
    {
        var pacienteId = PacienteId;
        if (string.IsNullOrEmpty(pacienteId))
            return;

        _spinnerService.Show();
        unPaciente = await _obtenerGrupoFamiliarUseCase.EjecutarAsync(pacienteId);
        _elegibles = await _obtenerFamiliaresElegiblesUseCase.EjecutarAsync(pacienteId);
        _spinnerService.Hide();
    }

    private FamiliarPerfil? BuscarElegible(Relacion relacion)
    {
        var id = relacion.referencia?.id ?? relacion.referencia?._id;
        if (string.IsNullOrWhiteSpace(id))
            return null;

        return _elegibles.FirstOrDefault(e =>
            string.Equals(e.Id, id, StringComparison.OrdinalIgnoreCase));
    }

    private async Task UsarPerfilAsync(FamiliarPerfil familiar)
    {
        await PerfilActivo.SeleccionarFamiliarAsync(familiar);
        await RefreshPerfilActivoAsync();
        _mensaje = $"Ahora operás como {familiar.NombreCompleto}.";
        StateHasChanged();
    }

    private async Task SalirDeFamiliarAsync()
    {
        await PerfilActivo.SalirAsync();
        await RefreshPerfilActivoAsync();
        _mensaje = "Volviste a tu perfil.";
        StateHasChanged();
    }
}
