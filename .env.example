# Copiar a .env y completar: copy .env.example .env
# Uso: docker run -d -p 8080:8080 --env-file .env -v ./certs:/certs:ro salud-web
# Las variables marcadas como REQUERIDA deben tener valor para que el portal funcione.

ASPNETCORE_ENVIRONMENT=Production

# --- Andes ---
# REQUERIDA
ApiAndes__baseUrl=
# REQUERIDA: app-token para restablecer contraseña
ApiAndes__TokenRestablecerPassword=

# --- X-Road (RENAPER + RANIA). El .pfx va en ./certs, montado en /certs ---
# REQUERIDA
ApiXroadssAndes__baseUrl=
# REQUERIDA
ApiXroadssAndes__CertPath=/certs/xroad.pfx
# REQUERIDA: puede quedar vacía si el .pfx no tiene contraseña
ApiXroadssAndes__CertPassword=

# --- LASCHyBS (laboratorio) ---
# REQUERIDA
ApiLASCHyBS__baseUrl=

# --- Recetar (prescripciones) ---
# REQUERIDA
ApiRecetar__baseUrl=
# REQUERIDA
ApiRecetar__AccessToken=

# --- Admin (opcional): ApiKey vacía desactiva el envío de logs/telemetría ---
AdminLogs__BaseUrl=
AdminLogs__ApiKey=

# --- Otros (opcional) ---
Turnos__MinutosVisualizacionTelemedicina=480
